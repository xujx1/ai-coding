{
  "name": "ai-coding-pipeline",
  "version": "1.0.0",
  "description": "Web AI Coding Pipeline - MRD to Code Workbench",
  "main": "dist/server/app.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "playwright:install": "playwright install chromium",
    "start": "node dist/server/app.js",
    "dev": "tsx watch src/server/app.ts",
    "ecom:git": "tsx src/cli/local-git-service.ts --root demo/ecom"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@langchain/core": "1.2.1",
    "@langchain/langgraph": "1.4.7",
    "adm-zip": "^0.5.16",
    "diff": "^7.0.0",
    "gitnexus": "^1.6.9",
    "hono": "^4.6.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "playwright": "^1.61.1",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/adm-zip": "^0.5.5",
    "@types/diff": "^6.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
