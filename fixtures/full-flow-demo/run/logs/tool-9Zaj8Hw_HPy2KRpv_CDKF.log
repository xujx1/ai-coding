  43	    void deleteSuccess() throws Exception {
  44	        when(activityService.deleteActivity(any(DeleteActivityRequest.class)))
  45	                .thenReturn(RpcResult.success(null, "req-success"));
  46	
  47	        mockMvc.perform(post("/api/activity/delete")
  48	                        .contentType(MediaType.APPLICATION_JSON)
  49	                        .content(validRequestJson()))
  50	                .andExpect(status().isOk())
  51	                .andExpect(jsonPath("$.code").value(ErrorCode.SUCCESS.getCode()))
  52	                .andExpect(jsonPath("$.message").value(ErrorCode.SUCCESS.getMessage()))
  53	                .andExpect(jsonPath("$.success").value(true))
  54	                .andExpect(jsonPath("$.requestId").value("req-success"));
  55	
  56	        verify(activityService).deleteActivity(any(DeleteActivityRequest.class));
  57	    }
