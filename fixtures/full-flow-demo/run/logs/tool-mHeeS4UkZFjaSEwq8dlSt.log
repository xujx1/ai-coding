  13	/**
  14	 * Publishes B-to-C and C-to-B sync events via Kafka with reliable logging and DLQ fallback.
  15	 */
  16	@Service
  17	public class SyncEventPublisher {
  18	
  19	    @Autowired
  20	    private KafkaProducer kafkaProducer;
  21	
  22	    @Autowired
  23	    private IdGenerator idGenerator;
  24	
  25	    @Autowired
  26	    private SyncEventLogMapper syncEventLogMapper;
  27	
  28	    @Autowired
  29	    private DlqService dlqService;
  30	
  31	    /**
  32	     * Publish a B-to-C sync event (business-side changes propagated to C-end runtime).
  33	     * Returns the generated event ID for correlation.
  34	     *
  35	     * @param eventType     the event type (e.g. ACTIVITY_ONLINE, PRODUCT_BOUND)
  36	     * @param aggregateType the aggregate type
  37	     * @param aggregateId   the aggregate ID
  38	     * @param regionCode    the region code
  39	     * @param version       the aggregate version after the change
  40	     * @param payload       JSON payload of the event
  41	     * @return the generated event ID
  42	     */
  43	    public String publishEvent(String eventType, String aggregateType, String aggregateId,
  44	                               String regionCode, Long version, String payload) {
  45	        long now = System.currentTimeMillis();
  46	        SyncEvent event = SyncEvent.of(
  47	                idGenerator.generateEventId(), eventType, aggregateType, aggregateId,
  48	                regionCode, version, payload, now
  49	        );
  50	
  51	        String topic = KafkaTopicConfig.B_TO_C_SYNC_TOPIC;
  52	        boolean sent = kafkaProducer.send(topic, event);
  53	
  54	        // Log the event for observability and replay
  55	        SyncEventLog log = new SyncEventLog();
  56	        log.setEventId(event.getEventId());
  57	        log.setEventType(eventType);
  58	        log.setAggregateType(aggregateType);
  59	        log.setAggregateId(aggregateId);
  60	        log.setRegionCode(regionCode);
  61	        log.setVersion(version);
  62	        log.setPayload(payload);
  63	        log.setConsumerGroup("b2c-runtime");
  64	        log.setConsumeStatus(sent ? SyncEventLog.STATUS_SUCCESS : SyncEventLog.STATUS_PENDING);
  65	        log.setOccurredAt(now);
  66	        log.setCreatedAt(now);
  67	        log.setUpdatedAt(now);
  68	        if (!sent) {
  69	            log.setErrorMessage("Kafka send failed");
  70	            dlqService.sendToDlq(event.getEventId(), topic, "b2c-runtime", payload, "Kafka send failed", regionCode);
  71	        }
  72	        syncEventLogMapper.insert(log);
  73	
  74	        return event.getEventId();
  75	    }
  76	
  77	    /**
  78	     * Publish a C-to-B event (C-end actions propagated back to business-side).
  79	     *
  80	     * @param eventType     the event type
  81	     * @param aggregateType the aggregate type
  82	     * @param aggregateId   the aggregate ID
  83	     * @param regionCode    the region code
  84	     * @param version       the aggregate version
  85	     * @param payload       JSON payload
  86	     * @return the generated event ID
  87	     */
  88	    public String publishC2BEvent(String eventType, String aggregateType, String aggregateId,
  89	                                  String regionCode, Long version, String payload) {
  90	        SyncEvent event = SyncEvent.of(
  91	                idGenerator.generateEventId(), eventType, aggregateType, aggregateId,
  92	                regionCode, version, payload, System.currentTimeMillis()
  93	        );
  94	        kafkaProducer.send(KafkaTopicConfig.C_TO_B_EVENT_TOPIC, event);
  95	        return event.getEventId();
  96	    }
  97	}
