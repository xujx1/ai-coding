 224	    private void assertIllegalState(String status) {
 225	        DeleteActivityRequest request = buildRequest("req-" + status, "idem-" + status, "act-" + status, "CN", "operator");
 226	        Activity activity = buildActivity("act-" + status, "CN", status, 0, false, "old");
 227	
 228	        when(idempotencyService.checkAndRecord(eq("idem-" + status), eq("CN"), eq(expectedRequestHash(request)), eq(7), eq("req-" + status)))
 229	                .thenReturn(null);
 230	        when(activityMapper.selectByActivityId("act-" + status, "CN")).thenReturn(activity);
 231	
 232	        RpcResult<Void> result = activityService.deleteActivity(request);
 233	
 234	        assertEquals(ErrorCode.ILLEGAL_STATE.getCode(), result.getCode());
 235	        assertTrue(result.getMessage().contains(status));
 236	        verify(activityMapper, never()).softDelete(eq("act-" + status), eq("CN"), eq(status), eq(0), anyLong(), eq("operator"));
 237	        verifyNoInteractions(auditService);
 238	    }
