 203	    @Test
 204	    @DisplayName("deleteActivity returns version conflict when concurrent delete leaves record still deletable")
 205	    void deleteActivityConcurrentDeleteVersionConflict() {
 206	        DeleteActivityRequest request = buildRequest("req-7", "idem-7", "act-7", "CN", "operator-7");
 207	        Activity activity = buildActivity("act-7", "CN", ActivityStatus.DRAFT.name(), 2, false, "old");
 208	        Activity current = buildActivity("act-7", "CN", ActivityStatus.DRAFT.name(), 2, false, "old");
 209	
 210	        when(idempotencyService.checkAndRecord(eq("idem-7"), eq("CN"), eq(expectedRequestHash(request)), eq(7), eq("req-7")))
 211	                .thenReturn(null);
 212	        when(activityMapper.selectByActivityId("act-7", "CN")).thenReturn(activity, current);
 213	        when(activityMapper.softDelete(eq("act-7"), eq("CN"), eq(ActivityStatus.DRAFT.name()), eq(2), anyLong(), eq("operator-7")))
 214	                .thenReturn(0);
 215	
 216	        RpcResult<Void> result = activityService.deleteActivity(request);
 217	
 218	        assertEquals(ErrorCode.VERSION_CONFLICT.getCode(), result.getCode());
 219	        assertEquals("Concurrent delete detected", result.getMessage());
 220	        verifyNoInteractions(auditService);
 221	        verify(idempotencyService, never()).markCompleted(eq("idem-7"), eq("CN"), eq(""));
 222	    }
