 101	        Activity activity = buildActivity("act-2", "CN", ActivityStatus.REJECTED.name(), 5, false, "old-operator");
 102	
 103	        when(idempotencyService.checkAndRecord(eq("idem-2"), eq("CN"), eq(expectedRequestHash(request)), eq(7), eq("req-2")))
 104	                .thenReturn(null);
 105	        when(activityMapper.selectByActivityId("act-2", "CN")).thenReturn(activity);
 106	        when(activityMapper.softDelete(eq("act-2"), eq("CN"), eq(ActivityStatus.REJECTED.name()), eq(5), anyLong(), eq("operator-2")))
 107	                .thenReturn(1);
 108	
 109	        activityService.deleteActivity(request);
 110	
 111	        ArgumentCaptor<String> beforeCaptor = ArgumentCaptor.forClass(String.class);
 112	        ArgumentCaptor<String> afterCaptor = ArgumentCaptor.forClass(String.class);
 113	        verify(auditService).logStateChange(eq("req-2"), eq("operator-2"), eq("DELETE_ACTIVITY"),
 114	                eq("Activity"), eq("act-2"), eq("CN"), beforeCaptor.capture(), afterCaptor.capture());
 115	        assertTrue(beforeCaptor.getValue().contains("\"status\":\"REJECTED\""));
 116	        assertTrue(beforeCaptor.getValue().contains("\"isDeleted\":false"));
 117	        assertTrue(beforeCaptor.getValue().contains("\"version\":5"));
 118	        assertTrue(afterCaptor.getValue().contains("\"updatedBy\":\"operator-2\""));
 119	        assertTrue(afterCaptor.getValue().contains("\"isDeleted\":true"));
 120	        assertTrue(afterCaptor.getValue().contains("\"version\":6"));
