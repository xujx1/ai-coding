 240	    private DeleteActivityRequest buildRequest(String requestId, String idempotencyKey, String activityId,
 241	                                               String regionCode, String operator) {
 242	        DeleteActivityRequest request = new DeleteActivityRequest();
 243	        request.setRequestId(requestId);
 244	        request.setIdempotencyKey(idempotencyKey);
 245	        request.setActivityId(activityId);
 246	        request.setRegionCode(regionCode);
 247	        request.setOperator(operator);
 248	        request.setCaller("caller");
 249	        request.setTimestampMs(1000L);
 250	        return request;
 251	    }
 252	
 253	    private Activity buildActivity(String activityId, String regionCode, String status, int version,
 254	                                   boolean isDeleted, String updatedBy) {
 255	        Activity activity = new Activity();
 256	        activity.setActivityId(activityId);
 257	        activity.setRegionCode(regionCode);
 258	        activity.setStatus(status);
 259	        activity.setVersion(version);
 260	        activity.setIsDeleted(isDeleted);
 261	        activity.setUpdatedBy(updatedBy);
 262	        activity.setUpdatedAt(123L);
 263	        activity.setCreatedBy("creator");
 264	        activity.setCreatedAt(100L);
 265	        activity.setActivityName("activity-" + activityId);
 266	        activity.setToolId("tool-1");
 267	        activity.setToolType("FULL_REDUCE");
 268	        activity.setTenantId("tenant-1");
 269	        return activity;
 270	    }
