  66	    @Test
  67	    @DisplayName("deleteActivity deletes a draft activity and records audit plus idempotency result")
  68	    void deleteActivityDraftSuccess() {
  69	        DeleteActivityRequest request = buildRequest("req-1", "idem-1", "act-1", "CN", "operator-1");
  70	        Activity activity = buildActivity("act-1", "CN", ActivityStatus.DRAFT.name(), 3, false, "creator");
  71	
  72	        when(idempotencyService.checkAndRecord(eq("idem-1"), eq("CN"), eq(expectedRequestHash(request)), eq(7), eq("req-1")))
  73	                .thenReturn(null);
  74	        when(activityMapper.selectByActivityId("act-1", "CN")).thenReturn(activity);
  75	        when(activityMapper.softDelete(eq("act-1"), eq("CN"), eq(ActivityStatus.DRAFT.name()), eq(3), anyLong(), eq("operator-1")))
  76	                .thenReturn(1);
  77	
  78	        RpcResult<Void> result = activityService.deleteActivity(request);
  79	
  80	        assertTrue(result.isSuccess());
  81	        assertEquals(ErrorCode.SUCCESS.getCode(), result.getCode());
  82	        assertEquals("req-1", result.getRequestId());
  83	
  84	        ArgumentCaptor<String> beforeCaptor = ArgumentCaptor.forClass(String.class);
  85	        ArgumentCaptor<String> afterCaptor = ArgumentCaptor.forClass(String.class);
  86	        verify(auditService).logStateChange(eq("req-1"), eq("operator-1"), eq("DELETE_ACTIVITY"),
  87	                eq("Activity"), eq("act-1"), eq("CN"), beforeCaptor.capture(), afterCaptor.capture());
  88	        assertTrue(beforeCaptor.getValue().contains("\"status\":\"DRAFT\""));
  89	        assertTrue(beforeCaptor.getValue().contains("\"isDeleted\":false"));
  90	        assertTrue(beforeCaptor.getValue().contains("\"version\":3"));
  91	        assertTrue(afterCaptor.getValue().contains("\"isDeleted\":true"));
  92	        assertTrue(afterCaptor.getValue().contains("\"version\":4"));
  93	        assertTrue(afterCaptor.getValue().contains("\"updatedBy\":\"operator-1\""));
  94	        verify(idempotencyService).markCompleted(eq("idem-1"), eq("CN"), eq("{\"code\":0,\"message\":\"SUCCESS\",\"requestId\":\"req-1\",\"data\":null,\"success\":true}"));
  95	    }
