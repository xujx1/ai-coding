 274	                + request.getOperator() + "\",\"regionCode\":\"" + request.getRegionCode()
 275	                + "\",\"idempotencyKey\":\"" + request.getIdempotencyKey()
 276	                + "\",\"timestampMs\":1000,\"expectedVersion\":null,\"activityId\":\""
 277	                + request.getActivityId() + "\"}";
