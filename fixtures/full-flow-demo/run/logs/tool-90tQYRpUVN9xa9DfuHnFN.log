 582	    // =========================================================================
 583	    // 8. forceOfflineActivity
 584	    // =========================================================================
 585	
 586	    /**
 587	     * Forcefully terminate an activity (emergency offline). This is a critical operation
 588	     * that bypasses normal state machine transitions and immediately blacklists the activity.
 589	     */
 590	    @Transactional(rollbackFor = Exception.class)
 591	    public RpcResult<Void> forceOfflineActivity(ForceOfflineRequest req) {
 592	        RuleValidator.validateRegionCode(req.getRegionCode());
 593	        RuleValidator.validateIdempotencyKey(req.getIdempotencyKey());
 594	
 595	        String requestHash = hashRequest(req);
 596	        @SuppressWarnings("unchecked")
 597	        RpcResult<Void> cached = idempotencyService.checkAndRecord(
 598	                req.getIdempotencyKey(), req.getRegionCode(), requestHash, IDEMPOTENCY_TTL_DAYS, req.getRequestId());
 599	        if (cached != null) {
 600	            return cached;
 601	        }
 602	
 603	        Activity activity = activityMapper.selectByActivityId(req.getActivityId(), req.getRegionCode());
 604	        if (activity == null) {
 605	            return RpcResult.fail(ErrorCode.RESOURCE_NOT_FOUND, "Activity not found", req.getRequestId());
 606	        }
 607	
 608	        if (ActivityStatus.TERMINATED.name().equals(activity.getStatus())) {
 609	            RpcResult<Void> result = RpcResult.success(null, req.getRequestId());
 610	            idempotencyService.markCompleted(req.getIdempotencyKey(), req.getRegionCode(), toJson(result));
 611	            return result;
 612	        }
 613	
 614	        // Force transition: any non-terminal state -> TERMINATED
 615	        String beforeJson = toJson(activity);
 616	        long now = System.currentTimeMillis();
 617	        int oldVersion = activity.getVersion();
 618	        int newVersion = oldVersion + 1;
 619	
 620	        int rows = activityMapper.updateStatusForceOffline(
 621	                req.getActivityId(), req.getRegionCode(),
 622	                activity.getStatus(), ActivityStatus.TERMINATED.name(),
 623	                req.getReason(),
 624	                oldVersion, newVersion, now, req.getOperator());
 625	        if (rows == 0) {
 626	            return RpcResult.fail(ErrorCode.ILLEGAL_STATE, "Concurrent state modification detected", req.getRequestId());
 627	        }
 628	
 629	        activity.setStatus(ActivityStatus.TERMINATED.name());
 630	        activity.setForceOfflineReason(req.getReason());
 631	        activity.setVersion(newVersion);
 632	        activity.setUpdatedAt(now);
 633	        activity.setUpdatedBy(req.getOperator());
 634	
 635	        String afterJson = toJson(activity);
 636	
 637	        // Critical operation - log with reason
 638	        auditService.logStateChange(
 639	                req.getRequestId(), req.getOperator(), "FORCE_OFFLINE_ACTIVITY",
 640	                AGGREGATE_TYPE, activity.getActivityId(), req.getRegionCode(),
 641	                beforeJson, afterJson);
 642	
 643	        // Publish high-priority force offline event
 644	        syncEventPublisher.publishEvent(
 645	                "ACTIVITY_FORCE_OFFLINE", AGGREGATE_TYPE, activity.getActivityId(),
 646	                req.getRegionCode(), activity.getVersion().longValue(), afterJson);
 647	
 648	        // Add to blacklist cache for 24 hours so C-end rejects immediately
 649	        String blacklistKey = "force_offline:" + req.getRegionCode() + ":" + req.getActivityId();
 650	        localCache.put("blacklist", blacklistKey, Boolean.TRUE, 24, TimeUnit.HOURS);
 651	
 652	        idempotencyService.markCompleted(req.getIdempotencyKey(), req.getRegionCode(),
 653	                toJson(RpcResult.success(null, req.getRequestId())));
 654	
 655	        return RpcResult.success(null, req.getRequestId());
 656	    }
