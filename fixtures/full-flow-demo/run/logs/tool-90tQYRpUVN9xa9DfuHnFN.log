 768	    private RpcResult<Void> validateDeleteRequest(DeleteActivityRequest req) {
 769	        if (req == null) {
 770	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "request body is required", null);
 771	        }
 772	        if (req.getActivityId() == null || req.getActivityId().trim().isEmpty()) {
 773	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "activityId is required", req.getRequestId());
 774	        }
 775	        if (req.getRegionCode() == null || req.getRegionCode().trim().isEmpty()) {
 776	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "regionCode is required", req.getRequestId());
 777	        }
 778	        if (req.getIdempotencyKey() == null || req.getIdempotencyKey().trim().isEmpty()) {
 779	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "idempotencyKey is required", req.getRequestId());