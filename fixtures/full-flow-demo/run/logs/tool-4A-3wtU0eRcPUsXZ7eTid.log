  44	    @Test
  45	    @DisplayName("POST /api/activity/delete returns success payload from service")
  46	    void deleteSuccess() throws Exception {
  47	        when(activityService.deleteActivity(any(DeleteActivityRequest.class)))
  48	                .thenReturn(RpcResult.success(null, "req-success"));
  49	
  50	        mockMvc.perform(post("/api/activity/delete")
  51	                        .contentType(MediaType.APPLICATION_JSON)
  52	                        .content(validRequestJson()))
  53	                .andExpect(status().isOk())
  54	                .andExpect(jsonPath("$.code").value(ErrorCode.SUCCESS.getCode()))
  55	                .andExpect(jsonPath("$.message").value(ErrorCode.SUCCESS.getMessage()))
  56	                .andExpect(jsonPath("$.success").value(true))
  57	                .andExpect(jsonPath("$.requestId").value("req-success"));
  58	
  59	        verify(activityService).deleteActivity(any(DeleteActivityRequest.class));
  60	    }
