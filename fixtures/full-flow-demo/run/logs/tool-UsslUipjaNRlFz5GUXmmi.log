 140	    /**
 141	     * Helper that builds a valid CreateActivityRequest with sensible defaults for FULL_REDUCE tool type.
 142	     * Each call produces a unique idempotencyKey and requestId.
 143	     */
 144	    protected CreateActivityRequest buildCreateRequest(String name) {
 145	        CreateActivityRequest req = new CreateActivityRequest();
 146	        req.setRequestId("req-" + System.nanoTime());
 147	        req.setCaller(CALLER);
 148	        req.setOperator(OPERATOR);
 149	        req.setRegionCode(REGION_CN);
 150	        req.setIdempotencyKey("idem-" + System.nanoTime());
 151	        req.setTimestampMs(System.currentTimeMillis());
 152	        req.setActivityName(name);
 153	        req.setToolId("tool-full-reduce");
 154	        req.setToolType("FULL_REDUCE");
 155	        req.setTenantId("tenant-001");
 156	        req.setThresholdAmount(new BigDecimal("100.00"));
 157	        req.setDiscountAmount(new BigDecimal("20.00"));
 158	        req.setStartTime(System.currentTimeMillis() + 3600000L);
 159	        req.setEndTime(System.currentTimeMillis() + 86400000L);
 160	        req.setScopeType("ALL");
 161	        req.setIsPurchaseLimited(false);
 162	        req.setPurchaseLimitPerUser(1);
 163	        return req;
 164	    }
