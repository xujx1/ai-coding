 301	    /**
 302	     * Approve a PENDING_APPROVAL activity.
 303	     */
 304	    @Transactional(rollbackFor = Exception.class)
 305	    public RpcResult<ActivityDTO> approveActivity(ApproveActivityRequest req) {
 306	        RuleValidator.validateRegionCode(req.getRegionCode());
 307	        RuleValidator.validateIdempotencyKey(req.getIdempotencyKey());
 308	
 309	        String requestHash = hashRequest(req);
 310	        RpcResult<ActivityDTO> cached = idempotencyService.checkAndRecord(
 311	                req.getIdempotencyKey(), req.getRegionCode(), requestHash, IDEMPOTENCY_TTL_DAYS, req.getRequestId());
 312	        if (cached != null) {
 313	            return cached;
 314	        }
 315	
 316	        Activity activity = activityMapper.selectByActivityId(req.getActivityId(), req.getRegionCode());
 317	        if (activity == null) {
 318	            return RpcResult.fail(ErrorCode.RESOURCE_NOT_FOUND, "Activity not found", req.getRequestId());
 319	        }
 320	
 321	        if (!ActivityStatus.PENDING_APPROVAL.name().equals(activity.getStatus())) {
 322	            return RpcResult.fail(ErrorCode.ILLEGAL_STATE,
 323	                    "Only PENDING_APPROVAL activities can be approved, current: " + activity.getStatus(),
 324	                    req.getRequestId());
 325	        }
 326	
 327	        ActivityStateMachine.assertTransition(ActivityStatus.PENDING_APPROVAL, ActivityStatus.APPROVED);
 328	
 329	        String beforeJson = toJson(activity);
 330	        long now = System.currentTimeMillis();
 331	        int oldVersion = activity.getVersion();
 332	        int newVersion = oldVersion + 1;
 333	
 334	        int rows = activityMapper.updateStatusWithApproval(
 335	                req.getActivityId(), req.getRegionCode(),
 336	                ActivityStatus.PENDING_APPROVAL.name(), ActivityStatus.APPROVED.name(),
 337	                req.getApproverId(), now,
 338	                oldVersion, newVersion, now, req.getOperator(), null);
 339	        if (rows == 0) {
 340	            return RpcResult.fail(ErrorCode.ILLEGAL_STATE, "Concurrent state modification detected", req.getRequestId());
 341	        }
 342	
 343	        activity.setStatus(ActivityStatus.APPROVED.name());
 344	        activity.setApproverId(req.getApproverId());
 345	        activity.setApprovalTime(now);
 346	        activity.setRejectReason(null);
 347	        activity.setVersion(newVersion);
 348	        activity.setUpdatedAt(now);
 349	        activity.setUpdatedBy(req.getOperator());
 350	
 351	        String afterJson = toJson(activity);
 352	        auditService.logStateChange(
 353	                req.getRequestId(), req.getOperator(), "APPROVE_ACTIVITY",
 354	                AGGREGATE_TYPE, activity.getActivityId(), req.getRegionCode(),
 355	                beforeJson, afterJson);
 356	
 357	        syncEventPublisher.publishEvent(
 358	                "ACTIVITY_APPROVED", AGGREGATE_TYPE, activity.getActivityId(),
 359	                req.getRegionCode(), activity.getVersion().longValue(), afterJson);
 360	
 361	        idempotencyService.markCompleted(req.getIdempotencyKey(), req.getRegionCode(),
 362	                toJson(RpcResult.success(convertToDTO(activity), req.getRequestId())));
 363	
 364	        return RpcResult.success(convertToDTO(activity), req.getRequestId());
 365	    }
