  79	    /**
  80	     * Create a new activity in DRAFT status.
  81	     */
  82	    @Transactional(rollbackFor = Exception.class)
  83	    public RpcResult<ActivityDTO> createActivity(CreateActivityRequest req) {
  84	        // Validate
  85	        RuleValidator.validateRegionCode(req.getRegionCode());
  86	        RuleValidator.validateIdempotencyKey(req.getIdempotencyKey());
  87	        if (req.getActivityName() == null || req.getActivityName().isEmpty()) {
  88	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "activityName is required", req.getRequestId());
  89	        }
  90	
  91	        // Idempotency check
  92	        String requestHash = hashRequest(req);
  93	        RpcResult<ActivityDTO> cached = idempotencyService.checkAndRecord(
  94	                req.getIdempotencyKey(), req.getRegionCode(), requestHash, IDEMPOTENCY_TTL_DAYS, req.getRequestId());
  95	        if (cached != null) {
  96	            return cached;
  97	        }
  98	
  99	        long now = System.currentTimeMillis();
 100	
 101	        Activity activity = new Activity();
 102	        activity.setActivityId(idGenerator.generateId("act"));
 103	        activity.setTenantId(req.getTenantId());
 104	        activity.setActivityName(req.getActivityName());
 105	        activity.setRegionCode(req.getRegionCode());
 106	        activity.setToolId(req.getToolId());
 107	        activity.setToolType(req.getToolType());
 108	        activity.setStatus(ActivityStatus.DRAFT.name());
 109	        activity.setVersion(0);
 110	        activity.setThresholdAmount(req.getThresholdAmount());
 111	        activity.setDiscountAmount(req.getDiscountAmount());
 112	        activity.setDiscountRate(req.getDiscountRate());
 113	        activity.setMaxDiscount(req.getMaxDiscount());
 114	        activity.setCouponTemplateId(req.getCouponTemplateId());
 115	        activity.setStartTime(req.getStartTime());
 116	        activity.setEndTime(req.getEndTime());
 117	        activity.setScopeType(req.getScopeType());
 118	        activity.setScopeRefs(req.getScopeRefs());
 119	        activity.setIsPurchaseLimited(req.getIsPurchaseLimited() != null ? req.getIsPurchaseLimited() : false);
 120	        activity.setPurchaseLimitPerUser(req.getPurchaseLimitPerUser());
 121	        activity.setCreatedAt(now);
 122	        activity.setUpdatedAt(now);
 123	        activity.setCreatedBy(req.getOperator());
 124	        activity.setUpdatedBy(req.getOperator());
 125	
 126	        activityMapper.insert(activity);
 127	
 128	        // Audit log
 129	        String afterJson = toJson(activity);
 130	        auditService.logStateChange(
 131	                req.getRequestId(), req.getOperator(), "CREATE_ACTIVITY",
 132	                AGGREGATE_TYPE, activity.getActivityId(), req.getRegionCode(),
 133	                "{}", afterJson);
 134	
 135	        idempotencyService.markCompleted(req.getIdempotencyKey(), req.getRegionCode(),
 136	                toJson(RpcResult.success(convertToDTO(activity), req.getRequestId())));
 137	
 138	        return RpcResult.success(convertToDTO(activity), req.getRequestId());
 139	    }
