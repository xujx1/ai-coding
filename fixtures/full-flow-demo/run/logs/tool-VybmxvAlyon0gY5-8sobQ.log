 239	    /**
 240	     * Submit a DRAFT activity for approval.
 241	     */
 242	    @Transactional(rollbackFor = Exception.class)
 243	    public RpcResult<ActivityDTO> submitForApproval(SubmitApprovalRequest req) {
 244	        RuleValidator.validateRegionCode(req.getRegionCode());
 245	        RuleValidator.validateIdempotencyKey(req.getIdempotencyKey());
 246	
 247	        String requestHash = hashRequest(req);
 248	        RpcResult<ActivityDTO> cached = idempotencyService.checkAndRecord(
 249	                req.getIdempotencyKey(), req.getRegionCode(), requestHash, IDEMPOTENCY_TTL_DAYS, req.getRequestId());
 250	        if (cached != null) {
 251	            return cached;
 252	        }
 253	
 254	        Activity activity = activityMapper.selectByActivityId(req.getActivityId(), req.getRegionCode());
 255	        if (activity == null) {
 256	            return RpcResult.fail(ErrorCode.RESOURCE_NOT_FOUND, "Activity not found", req.getRequestId());
 257	        }
 258	
 259	        if (!ActivityStatus.DRAFT.name().equals(activity.getStatus())) {
 260	            return RpcResult.fail(ErrorCode.ILLEGAL_STATE,
 261	                    "Only DRAFT activities can be submitted for approval, current: " + activity.getStatus(),
 262	                    req.getRequestId());
 263	        }
 264	
 265	        ActivityStateMachine.assertTransition(ActivityStatus.DRAFT, ActivityStatus.PENDING_APPROVAL);
 266	
 267	        String beforeJson = toJson(activity);
 268	        long now = System.currentTimeMillis();
 269	        int oldVersion = activity.getVersion();
 270	        int newVersion = oldVersion + 1;
 271	
 272	        int rows = activityMapper.updateStatus(
 273	                req.getActivityId(), req.getRegionCode(),
 274	                ActivityStatus.DRAFT.name(), ActivityStatus.PENDING_APPROVAL.name(),
 275	                oldVersion, newVersion, now, req.getOperator());
 276	        if (rows == 0) {
 277	            return RpcResult.fail(ErrorCode.ILLEGAL_STATE, "Concurrent state modification detected", req.getRequestId());
 278	        }
 279	
 280	        activity.setStatus(ActivityStatus.PENDING_APPROVAL.name());
 281	        activity.setVersion(newVersion);
 282	        activity.setUpdatedAt(now);
 283	        activity.setUpdatedBy(req.getOperator());
 284	
 285	        String afterJson = toJson(activity);
 286	        auditService.logStateChange(
 287	                req.getRequestId(), req.getOperator(), "SUBMIT_APPROVAL",
 288	                AGGREGATE_TYPE, activity.getActivityId(), req.getRegionCode(),
 289	                beforeJson, afterJson);
 290	
 291	        idempotencyService.markCompleted(req.getIdempotencyKey(), req.getRegionCode(),
 292	                toJson(RpcResult.success(convertToDTO(activity), req.getRequestId())));
 293	
 294	        return RpcResult.success(convertToDTO(activity), req.getRequestId());
 295	    }
