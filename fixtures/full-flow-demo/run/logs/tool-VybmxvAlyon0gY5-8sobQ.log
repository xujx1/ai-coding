 145	    /**
 146	     * Update an existing activity. Only DRAFT or REJECTED activities can be edited.
 147	     */
 148	    @Transactional(rollbackFor = Exception.class)
 149	    public RpcResult<ActivityDTO> updateActivity(UpdateActivityRequest req) {
 150	        RuleValidator.validateRegionCode(req.getRegionCode());
 151	        RuleValidator.validateIdempotencyKey(req.getIdempotencyKey());
 152	
 153	        String requestHash = hashRequest(req);
 154	        RpcResult<ActivityDTO> cached = idempotencyService.checkAndRecord(
 155	                req.getIdempotencyKey(), req.getRegionCode(), requestHash, IDEMPOTENCY_TTL_DAYS, req.getRequestId());
 156	        if (cached != null) {
 157	            return cached;
 158	        }
 159	
 160	        Activity activity = activityMapper.selectByActivityId(req.getActivityId(), req.getRegionCode());
 161	        if (activity == null) {
 162	            return RpcResult.fail(ErrorCode.RESOURCE_NOT_FOUND, "Activity not found", req.getRequestId());
 163	        }
 164	
 165	        String currentStatus = activity.getStatus();
 166	        if (!ActivityStatus.DRAFT.name().equals(currentStatus)
 167	                && !ActivityStatus.REJECTED.name().equals(currentStatus)) {
 168	            return RpcResult.fail(ErrorCode.ILLEGAL_STATE,
 169	                    "Only DRAFT or REJECTED activities can be updated, current status: " + currentStatus,
 170	                    req.getRequestId());
 171	        }
 172	
 173	        String beforeJson = toJson(activity);
 174	        long now = System.currentTimeMillis();
 175	
 176	        // Optimistic locking: if expectedVersion provided, verify it matches
 177	        if (req.getExpectedVersion() != null && !req.getExpectedVersion().equals(activity.getVersion())) {
 178	            return RpcResult.fail(ErrorCode.VERSION_CONFLICT, "Version mismatch", req.getRequestId());
 179	        }
 180	
 181	        // Update mutable fields
 182	        if (req.getActivityName() != null) {
 183	            activity.setActivityName(req.getActivityName());
 184	        }
 185	        if (req.getThresholdAmount() != null) {
 186	            activity.setThresholdAmount(req.getThresholdAmount());
 187	        }
 188	        if (req.getDiscountAmount() != null) {
 189	            activity.setDiscountAmount(req.getDiscountAmount());
 190	        }
 191	        if (req.getDiscountRate() != null) {
 192	            activity.setDiscountRate(req.getDiscountRate());
 193	        }
 194	        if (req.getMaxDiscount() != null) {
 195	            activity.setMaxDiscount(req.getMaxDiscount());
 196	        }
 197	        if (req.getStartTime() != null) {
 198	            activity.setStartTime(req.getStartTime());
 199	        }
 200	        if (req.getEndTime() != null) {
 201	            activity.setEndTime(req.getEndTime());
 202	        }
 203	        if (req.getScopeType() != null) {
 204	            activity.setScopeType(req.getScopeType());
 205	        }
 206	        if (req.getScopeRefs() != null) {
 207	            activity.setScopeRefs(req.getScopeRefs());
 208	        }
 209	        activity.setUpdatedAt(now);
 210	        activity.setUpdatedBy(req.getOperator());
 211	
 212	        int rows = activityMapper.updateWithVersion(activity);
 213	        if (rows == 0) {
 214	            return RpcResult.fail(ErrorCode.VERSION_CONFLICT, "Concurrent update detected", req.getRequestId());
 215	        }
 216	
 217	        activity.setVersion(activity.getVersion() + 1);
 218	
 219	        String afterJson = toJson(activity);
 220	        auditService.logStateChange(
 221	                req.getRequestId(), req.getOperator(), "UPDATE_ACTIVITY",
 222	                AGGREGATE_TYPE, activity.getActivityId(), req.getRegionCode(),
 223	                beforeJson, afterJson);
 224	
 225	        syncEventPublisher.publishEvent(
 226	                "ACTIVITY_UPDATED", AGGREGATE_TYPE, activity.getActivityId(),
 227	                req.getRegionCode(), activity.getVersion().longValue(), afterJson);
 228	
 229	        idempotencyService.markCompleted(req.getIdempotencyKey(), req.getRegionCode(),
 230	                toJson(RpcResult.success(convertToDTO(activity), req.getRequestId())));
 231	
 232	        return RpcResult.success(convertToDTO(activity), req.getRequestId());
 233	    }
