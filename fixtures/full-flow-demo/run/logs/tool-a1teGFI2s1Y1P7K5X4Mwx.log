 662	    /**
 663	     * Soft delete an activity when the current status allows removal.
 664	     */
 665	    @Transactional(rollbackFor = Exception.class)
 666	    public RpcResult<Void> deleteActivity(DeleteActivityRequest req) {
 667	        RpcResult<Void> validationResult = validateDeleteRequest(req);
 668	        if (validationResult != null) {
 669	            return validationResult;
 670	        }
 671	
 672	        RuleValidator.validateRegionCode(req.getRegionCode());
 673	        RuleValidator.validateIdempotencyKey(req.getIdempotencyKey());
 674	
 675	        String requestHash = hashRequest(req);
 676	        RpcResult<Void> cached = idempotencyService.checkAndRecord(
 677	                req.getIdempotencyKey(), req.getRegionCode(), requestHash, IDEMPOTENCY_TTL_DAYS, req.getRequestId());
 678	        if (cached != null) {
 679	            return cached;
 680	        }
 681	
 682	        Activity activity = activityMapper.selectByActivityId(req.getActivityId(), req.getRegionCode());
 683	        if (activity == null) {
 684	            return RpcResult.fail(ErrorCode.RESOURCE_NOT_FOUND, "Activity not found", req.getRequestId());
 685	        }
 686	
 687	        if (!DELETABLE_STATUSES.contains(activity.getStatus())) {
 688	            return RpcResult.fail(ErrorCode.ILLEGAL_STATE,
 689	                    "Only DRAFT, REJECTED or TERMINATED activities can be deleted, current status: " + activity.getStatus(),
 690	                    req.getRequestId());
 691	        }
 692	
 693	        String beforeJson = toJson(activity);
 694	        long now = System.currentTimeMillis();
 695	        int rows = activityMapper.softDelete(
 696	                req.getActivityId(),
 697	                req.getRegionCode(),
 698	                activity.getStatus(),
 699	                activity.getVersion(),
 700	                now,
 701	                req.getOperator());
 702	        if (rows == 0) {
 703	            Activity current = activityMapper.selectByActivityId(req.getActivityId(), req.getRegionCode());
 704	            if (current == null) {
 705	                return RpcResult.fail(ErrorCode.RESOURCE_NOT_FOUND, "Activity not found", req.getRequestId());
 706	            }
 707	            if (!DELETABLE_STATUSES.contains(current.getStatus())) {
 708	                return RpcResult.fail(ErrorCode.ILLEGAL_STATE,
 709	                        "Only DRAFT, REJECTED or TERMINATED activities can be deleted, current status: " + current.getStatus(),
 710	                        req.getRequestId());
 711	            }
 712	            return RpcResult.fail(ErrorCode.VERSION_CONFLICT, "Concurrent delete detected", req.getRequestId());
 713	        }
 714	
 715	        activity.setIsDeleted(true);
 716	        activity.setUpdatedAt(now);
 717	        activity.setUpdatedBy(req.getOperator());
 718	        activity.setVersion(activity.getVersion() + 1);
 719	        String afterJson = toJson(activity);