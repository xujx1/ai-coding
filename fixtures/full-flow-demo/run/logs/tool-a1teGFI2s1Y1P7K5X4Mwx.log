 506	    /**
 507	     * Pause an ONLINE activity or resume a PAUSED activity (toggle).
 508	     */
 509	    @Transactional(rollbackFor = Exception.class)
 510	    public RpcResult<ActivityDTO> pauseActivity(PauseActivityRequest req) {
 511	        RuleValidator.validateRegionCode(req.getRegionCode());
 512	        RuleValidator.validateIdempotencyKey(req.getIdempotencyKey());
 513	
 514	        String requestHash = hashRequest(req);
 515	        RpcResult<ActivityDTO> cached = idempotencyService.checkAndRecord(
 516	                req.getIdempotencyKey(), req.getRegionCode(), requestHash, IDEMPOTENCY_TTL_DAYS, req.getRequestId());
 517	        if (cached != null) {
 518	            return cached;
 519	        }
 520	
 521	        Activity activity = activityMapper.selectByActivityId(req.getActivityId(), req.getRegionCode());
 522	        if (activity == null) {
 523	            return RpcResult.fail(ErrorCode.RESOURCE_NOT_FOUND, "Activity not found", req.getRequestId());
 524	        }
 525	
 526	        String currentStatus = activity.getStatus();
 527	        String targetStatus;
 528	        String eventType;
 529	        String operationType;
 530	
 531	        if (ActivityStatus.ONLINE.name().equals(currentStatus)) {
 532	            targetStatus = ActivityStatus.PAUSED.name();
 533	            eventType = "ACTIVITY_PAUSED";
 534	            operationType = "PAUSE_ACTIVITY";
 535	        } else if (ActivityStatus.PAUSED.name().equals(currentStatus)) {
 536	            targetStatus = ActivityStatus.ONLINE.name();
 537	            eventType = "ACTIVITY_RESUMED";
 538	            operationType = "RESUME_ACTIVITY";
 539	        } else {
 540	            return RpcResult.fail(ErrorCode.ILLEGAL_STATE,
 541	                    "Only ONLINE or PAUSED activities can be paused/resumed, current: " + currentStatus,
 542	                    req.getRequestId());
 543	        }
 544	
 545	        ActivityStateMachine.assertTransition(
 546	                ActivityStatus.valueOf(currentStatus), ActivityStatus.valueOf(targetStatus));
 547	
 548	        String beforeJson = toJson(activity);
 549	        long now = System.currentTimeMillis();
 550	        int oldVersion = activity.getVersion();
 551	        int newVersion = oldVersion + 1;
 552	
 553	        int rows = activityMapper.updateStatus(
 554	                req.getActivityId(), req.getRegionCode(),
 555	                currentStatus, targetStatus,
 556	                oldVersion, newVersion, now, req.getOperator());
 557	        if (rows == 0) {
 558	            return RpcResult.fail(ErrorCode.ILLEGAL_STATE, "Concurrent state modification detected", req.getRequestId());
 559	        }
 560	
 561	        activity.setStatus(targetStatus);
 562	        activity.setVersion(newVersion);
 563	        activity.setUpdatedAt(now);
 564	        activity.setUpdatedBy(req.getOperator());
 565	
 566	        String afterJson = toJson(activity);
 567	        auditService.logStateChange(
 568	                req.getRequestId(), req.getOperator(), operationType,
 569	                AGGREGATE_TYPE, activity.getActivityId(), req.getRegionCode(),
 570	                beforeJson, afterJson);
 571	
 572	        syncEventPublisher.publishEvent(
 573	                eventType, AGGREGATE_TYPE, activity.getActivityId(),
 574	                req.getRegionCode(), activity.getVersion().longValue(), afterJson);
 575	
 576	        idempotencyService.markCompleted(req.getIdempotencyKey(), req.getRegionCode(),
 577	                toJson(RpcResult.success(convertToDTO(activity), req.getRequestId())));
 578	
 579	        return RpcResult.success(convertToDTO(activity), req.getRequestId());
 580	    }
