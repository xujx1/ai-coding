 192	    @Test
 193	    void testForceOffline() {
 194	        // Create -> submit -> approve -> online
 195	        String activityId = createAndOnlineActivity("force-offline-test");
 196	
 197	        // Force offline
 198	        ForceOfflineRequest forceReq = new ForceOfflineRequest();
 199	        forceReq.setRequestId("req-" + System.nanoTime());
 200	        forceReq.setCaller(CALLER);
 201	        forceReq.setOperator(OPERATOR);
 202	        forceReq.setRegionCode(REGION_CN);
 203	        forceReq.setIdempotencyKey("force-" + System.nanoTime());
 204	        forceReq.setTimestampMs(System.currentTimeMillis());
 205	        forceReq.setActivityId(activityId);
 206	        forceReq.setReason("emergency");
 207	
 208	        RpcResult<Void> forceResult = activityService.forceOfflineActivity(forceReq);
 209	        assertTrue(forceResult.isSuccess(), "forceOfflineActivity should succeed: " + forceResult.getMessage());
 210	
 211	        // Verify blacklist cache entry
 212	        String blacklistKey = "force_offline:" + REGION_CN + ":" + activityId;
 213	        assertTrue(localCache.isMember("blacklist", blacklistKey),
 214	                "Activity should be in blacklist cache after force offline");
 215	
 216	        // Verify DB status is TERMINATED
 217	        Activity terminated = activityMapper.selectByActivityId(activityId, REGION_CN);
 218	        assertNotNull(terminated, "Activity should still exist in DB after force offline");
 219	        assertEquals(ActivityStatus.TERMINATED.name(), terminated.getStatus(),
 220	                "Activity status in DB should be TERMINATED");
 221	    }
