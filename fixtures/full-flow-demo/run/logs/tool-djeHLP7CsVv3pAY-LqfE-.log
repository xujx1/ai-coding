  99	    @Test
 100	    void testRejectFlow() {
 101	        // 1. Create activity
 102	        CreateActivityRequest createReq = buildCreateRequest("reject-test-activity");
 103	        RpcResult<ActivityDTO> createResult = activityService.createActivity(createReq);
 104	        assertTrue(createResult.isSuccess());
 105	        String activityId = createResult.getData().getActivityId();
 106	
 107	        // 2. Submit for approval
 108	        SubmitApprovalRequest submitReq = new SubmitApprovalRequest();
 109	        submitReq.setRequestId("req-" + System.nanoTime());
 110	        submitReq.setCaller(CALLER);
 111	        submitReq.setOperator(OPERATOR);
 112	        submitReq.setRegionCode(REGION_CN);
 113	        submitReq.setIdempotencyKey("sub-" + System.nanoTime());
 114	        submitReq.setTimestampMs(System.currentTimeMillis());
 115	        submitReq.setActivityId(activityId);
 116	        RpcResult<ActivityDTO> submitResult = activityService.submitForApproval(submitReq);
 117	        assertTrue(submitResult.isSuccess());
 118	        assertEquals(ActivityStatus.PENDING_APPROVAL.name(), submitResult.getData().getStatus());
 119	
 120	        // 3. Reject -> REJECTED
 121	        RejectActivityRequest rejectReq = new RejectActivityRequest();
 122	        rejectReq.setRequestId("req-" + System.nanoTime());
 123	        rejectReq.setCaller(CALLER);
 124	        rejectReq.setOperator(OPERATOR);
 125	        rejectReq.setRegionCode(REGION_CN);
 126	        rejectReq.setIdempotencyKey("rej-" + System.nanoTime());
 127	        rejectReq.setTimestampMs(System.currentTimeMillis());
 128	        rejectReq.setActivityId(activityId);
 129	        rejectReq.setApproverId("admin-1");
 130	        rejectReq.setReason("Does not meet quality standards");
 131	
 132	        RpcResult<ActivityDTO> rejectResult = activityService.rejectActivity(rejectReq);
 133	        assertTrue(rejectResult.isSuccess(), "rejectActivity should succeed: " + rejectResult.getMessage());
 134	        assertEquals(ActivityStatus.REJECTED.name(), rejectResult.getData().getStatus());
 135	
 136	        // 4. After rejection, the activity can be updated (REJECTED -> editable, stays DRAFT semantics)
 137	        UpdateActivityRequest updateReq = new UpdateActivityRequest();
 138	        updateReq.setRequestId("req-" + System.nanoTime());
 139	        updateReq.setCaller(CALLER);
 140	        updateReq.setOperator(OPERATOR);
 141	        updateReq.setRegionCode(REGION_CN);
 142	        updateReq.setIdempotencyKey("upd-" + System.nanoTime());
 143	        updateReq.setTimestampMs(System.currentTimeMillis());
 144	        updateReq.setActivityId(activityId);
 145	        updateReq.setActivityName("rejected-then-updated-activity");
 146	        updateReq.setThresholdAmount(new BigDecimal("200.00"));
 147	        updateReq.setDiscountAmount(new BigDecimal("50.00"));
 148	
 149	        RpcResult<ActivityDTO> updateResult = activityService.updateActivity(updateReq);
 150	        assertTrue(updateResult.isSuccess(),
 151	                "Updating a REJECTED activity should succeed: " + updateResult.getMessage());
 152	        assertNotNull(updateResult.getData());
 153	        assertEquals("rejected-then-updated-activity", updateResult.getData().getActivityName());
 154	    }
