 156	    @Test
 157	    void testPauseAndResume() {
 158	        // Create -> submit -> approve -> online
 159	        String activityId = createAndOnlineActivity("pause-resume-test");
 160	
 161	        // 1. Pause -> PAUSED
 162	        PauseActivityRequest pauseReq = new PauseActivityRequest();
 163	        pauseReq.setRequestId("req-" + System.nanoTime());
 164	        pauseReq.setCaller(CALLER);
 165	        pauseReq.setOperator(OPERATOR);
 166	        pauseReq.setRegionCode(REGION_CN);
 167	        pauseReq.setIdempotencyKey("pause-" + System.nanoTime());
 168	        pauseReq.setTimestampMs(System.currentTimeMillis());
 169	        pauseReq.setActivityId(activityId);
 170	
 171	        RpcResult<ActivityDTO> pauseResult = activityService.pauseActivity(pauseReq);
 172	        assertTrue(pauseResult.isSuccess(), "pauseActivity should succeed: " + pauseResult.getMessage());
 173	        assertEquals(ActivityStatus.PAUSED.name(), pauseResult.getData().getStatus(),
 174	                "Status should be PAUSED after first pause call");
 175	
 176	        // 2. Call pause again (toggle resume) -> ONLINE
 177	        PauseActivityRequest resumeReq = new PauseActivityRequest();
 178	        resumeReq.setRequestId("req-" + System.nanoTime());
 179	        resumeReq.setCaller(CALLER);
 180	        resumeReq.setOperator(OPERATOR);
 181	        resumeReq.setRegionCode(REGION_CN);
 182	        resumeReq.setIdempotencyKey("resume-" + System.nanoTime());
 183	        resumeReq.setTimestampMs(System.currentTimeMillis());
 184	        resumeReq.setActivityId(activityId);
 185	
 186	        RpcResult<ActivityDTO> resumeResult = activityService.pauseActivity(resumeReq);
 187	        assertTrue(resumeResult.isSuccess(), "Resuming (second pause toggle) should succeed: " + resumeResult.getMessage());
 188	        assertEquals(ActivityStatus.ONLINE.name(), resumeResult.getData().getStatus(),
 189	                "Status should be back to ONLINE after resume (toggle)");
 190	    }
