 223	    /**
 224	     * Convenience helper: creates, submits, approves, and onlines an activity, returning its activityId.
 225	     */
 226	    private String createAndOnlineActivity(String name) {
 227	        CreateActivityRequest createReq = buildCreateRequest(name);
 228	        RpcResult<ActivityDTO> createResult = activityService.createActivity(createReq);
 229	        assertTrue(createResult.isSuccess(), "create: " + createResult.getMessage());
 230	        String activityId = createResult.getData().getActivityId();
 231	
 232	        SubmitApprovalRequest submitReq = new SubmitApprovalRequest();
 233	        submitReq.setRequestId("req-" + System.nanoTime());
 234	        submitReq.setCaller(CALLER);
 235	        submitReq.setOperator(OPERATOR);
 236	        submitReq.setRegionCode(REGION_CN);
 237	        submitReq.setIdempotencyKey("sub-" + System.nanoTime());
 238	        submitReq.setTimestampMs(System.currentTimeMillis());
 239	        submitReq.setActivityId(activityId);
 240	        RpcResult<ActivityDTO> submitResult = activityService.submitForApproval(submitReq);
 241	        assertTrue(submitResult.isSuccess(), "submit: " + submitResult.getMessage());
 242	
 243	        ApproveActivityRequest approveReq = new ApproveActivityRequest();
 244	        approveReq.setRequestId("req-" + System.nanoTime());
 245	        approveReq.setCaller(CALLER);
 246	        approveReq.setOperator(OPERATOR);
 247	        approveReq.setRegionCode(REGION_CN);
 248	        approveReq.setIdempotencyKey("appr-" + System.nanoTime());
 249	        approveReq.setTimestampMs(System.currentTimeMillis());
 250	        approveReq.setActivityId(activityId);
 251	        approveReq.setApproverId("admin-1");
 252	        RpcResult<ActivityDTO> approveResult = activityService.approveActivity(approveReq);
 253	        assertTrue(approveResult.isSuccess(), "approve: " + approveResult.getMessage());
 254	
 255	        OnlineActivityRequest onlineReq = new OnlineActivityRequest();
 256	        onlineReq.setRequestId("req-" + System.nanoTime());
 257	        onlineReq.setCaller(CALLER);
 258	        onlineReq.setOperator(OPERATOR);
 259	        onlineReq.setRegionCode(REGION_CN);
 260	        onlineReq.setIdempotencyKey("onl-" + System.nanoTime());
 261	        onlineReq.setTimestampMs(System.currentTimeMillis());
 262	        onlineReq.setActivityId(activityId);
 263	        RpcResult<ActivityDTO> onlineResult = activityService.onlineActivity(onlineReq);
 264	        assertTrue(onlineResult.isSuccess(), "online: " + onlineResult.getMessage());
 265	        assertEquals(ActivityStatus.ONLINE.name(), onlineResult.getData().getStatus());
 266	
 267	        return activityId;
 268	    }
