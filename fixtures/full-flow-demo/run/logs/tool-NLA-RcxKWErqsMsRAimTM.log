   8	
   9	/**
  10	 * Writes audit logs for all state changes across aggregates for traceability and compliance.
  11	 */
  12	@Service
  13	public class AuditService {
  14	
  15	    @Autowired
  16	    private OperationAuditLogMapper auditLogMapper;
  17	
  18	    @Autowired
  19	    private IdGenerator idGenerator;
  20	
  21	    /**
  22	     * Log a state change event for an aggregate.
  23	     *
  24	     * @param requestId      the originating request ID for correlation
  25	     * @param operator       the operator (user or system) who triggered the change
  26	     * @param operationType  the type of operation (e.g. CREATE_ACTIVITY, APPROVE)
  27	     * @param aggregateType  the aggregate root type (e.g. Activity, CouponInstance)
  28	     * @param aggregateId    the ID of the aggregate being modified
  29	     * @param regionCode     the region code for data residency
  30	     * @param beforeSnapshot JSON snapshot of the aggregate before the change
  31	     * @param afterSnapshot  JSON snapshot of the aggregate after the change
  32	     */
  33	    public void logStateChange(String requestId, String operator, String operationType,
  34	                               String aggregateType, String aggregateId, String regionCode,
  35	                               String beforeSnapshot, String afterSnapshot) {
  36	        OperationAuditLog log = new OperationAuditLog();
  37	        log.setTraceId(idGenerator.generateId("trace"));
  38	        log.setRequestId(requestId);
  39	        log.setOperator(operator);
  40	        log.setOperationType(operationType);
  41	        log.setAggregateType(aggregateType);
  42	        log.setAggregateId(aggregateId);
  43	        log.setRegionCode(regionCode);
  44	        log.setBeforeSnapshot(beforeSnapshot);
  45	        log.setAfterSnapshot(afterSnapshot);
  46	        log.setCreatedAt(System.currentTimeMillis());
  47	        auditLogMapper.insert(log);
  48	    }
  49	}
