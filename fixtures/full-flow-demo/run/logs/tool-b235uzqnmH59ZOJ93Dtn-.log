 768	    private RpcResult<Void> validateDeleteRequest(DeleteActivityRequest req) {
 769	        if (req == null) {
 770	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "request body is required", null);
 771	        }
 772	        if (req.getRequestId() == null || req.getRequestId().trim().isEmpty()) {
 773	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "requestId is required", null);
 774	        }
 775	        if (req.getActivityId() == null || req.getActivityId().trim().isEmpty()) {
 776	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "activityId is required", req.getRequestId());
 777	        }
 778	        if (req.getRegionCode() == null || req.getRegionCode().trim().isEmpty()) {
 779	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "regionCode is required", req.getRequestId());
 780	        }
 781	        if (req.getIdempotencyKey() == null || req.getIdempotencyKey().trim().isEmpty()) {
 782	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "idempotencyKey is required", req.getRequestId());
 783	        }
 784	        if (req.getOperator() == null || req.getOperator().trim().isEmpty()) {
 785	            return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "operator is required", req.getRequestId());
 786	        }
 787	        return null;
 788	    }
