  16	@RestControllerAdvice
  17	public class GlobalExceptionHandler {
  18	
  19	    /**
  20	     * Handles bean validation failures raised by {@code @Valid}.
  21	     */
  22	    @ExceptionHandler(MethodArgumentNotValidException.class)
  23	    public RpcResult<Void> handleMethodArgumentNotValid(MethodArgumentNotValidException ex,
  24	                                                        HttpServletRequest request) {
  25	        FieldError fieldError = ex.getBindingResult().getFieldError();
  26	        String message = fieldError != null ? fieldError.getDefaultMessage() : ErrorCode.INVALID_ARGUMENT.getMessage();
  27	        return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, message, extractRequestId(request));
  28	    }
  29	
  30	    /**
