  33	    @ExceptionHandler(HttpMessageNotReadableException.class)
  34	    public RpcResult<Void> handleHttpMessageNotReadable(HttpMessageNotReadableException ex,
  35	                                                        HttpServletRequest request) {
  36	        return RpcResult.fail(ErrorCode.INVALID_ARGUMENT, "request body is required", extractRequestId(request));
  37	    }
  38	
  39	    /**
