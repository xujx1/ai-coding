  43	    /**
  44	     * Validates coupon template fields.
  45	     * faceValue must be positive; minAmount must be non-null and non-negative;
  46	     * totalCount and perUserLimit must be positive.
  47	     *
  48	     * @param faceValue     coupon face value
  49	     * @param minAmount     minimum order amount
  50	     * @param totalCount    total coupon count
  51	     * @param perUserLimit  per-user claim limit
  52	     * @throws IllegalArgumentException if validation fails
  53	     */
  54	    public static void validateCouponTemplate(BigDecimal faceValue, BigDecimal minAmount,
  55	                                              Integer totalCount, Integer perUserLimit) {
  56	        if (faceValue == null) {
  57	            throw new IllegalArgumentException("faceValue must not be null");
  58	        }
  59	        if (faceValue.compareTo(BigDecimal.ZERO) <= 0) {
  60	            throw new IllegalArgumentException("faceValue must be positive, got: " + faceValue);
  61	        }
  62	        if (minAmount == null) {
  63	            throw new IllegalArgumentException("minAmount must not be null");
  64	        }
  65	        if (minAmount.compareTo(BigDecimal.ZERO) < 0) {
  66	            throw new IllegalArgumentException("minAmount must not be negative, got: " + minAmount);
  67	        }
  68	        if (totalCount == null || totalCount <= 0) {
  69	            throw new IllegalArgumentException("totalCount must be positive, got: " + totalCount);
  70	        }
  71	        if (perUserLimit == null || perUserLimit <= 0) {
  72	            throw new IllegalArgumentException("perUserLimit must be positive, got: " + perUserLimit);
  73	        }
  74	    }
