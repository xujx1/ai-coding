  15	    /**
  16	     * Validates activity time window.
  17	     * Both startTime and endTime must be non-null and positive; startTime must be strictly less than endTime.
  18	     *
  19	     * @param startTime activity start time (epoch millis)
  20	     * @param endTime   activity end time (epoch millis)
  21	     * @throws IllegalArgumentException if validation fails
  22	     */
  23	    public static void validateActivityTime(Long startTime, Long endTime) {
  24	        if (startTime == null) {
  25	            throw new IllegalArgumentException("startTime must not be null");
  26	        }
  27	        if (endTime == null) {
  28	            throw new IllegalArgumentException("endTime must not be null");
  29	        }
  30	        if (startTime <= 0L) {
  31	            throw new IllegalArgumentException("startTime must be positive, got: " + startTime);
  32	        }
  33	        if (endTime <= 0L) {
  34	            throw new IllegalArgumentException("endTime must be positive, got: " + endTime);
  35	        }
  36	        if (startTime >= endTime) {
  37	            throw new IllegalArgumentException(
  38	                    "startTime must be less than endTime, got startTime=" + startTime + ", endTime=" + endTime
  39	            );
  40	        }
  41	    }
