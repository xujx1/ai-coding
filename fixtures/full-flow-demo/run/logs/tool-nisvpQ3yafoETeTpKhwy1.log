 235	    private void assertIllegalState(String status) {
 236	        DeleteActivityRequest request = buildRequest("req-" + status, "idem-" + status, "act-" + status, "CN", "operator");
 237	        Activity activity = buildActivity("act-" + status, "CN", status, 0, false, "old");
 238	
 239	        when(idempotencyService.checkAndRecord(eq("idem-" + status), eq("CN"), eq(expectedRequestHash(request)), eq(7), eq("req-" + status)))
 240	                .thenReturn(null);
 241	        when(activityMapper.selectByActivityId("act-" + status, "CN")).thenReturn(activity);
 242	
 243	        RpcResult<Void> result = activityService.deleteActivity(request);
 244	
 245	        assertEquals(ErrorCode.ILLEGAL_STATE.getCode(), result.getCode());
 246	        assertTrue(result.getMessage().contains(status));
 247	        verify(activityMapper, never()).softDelete(eq("act-" + status), eq("CN"), eq(status), eq(0), anyLong(), eq("operator"));
 248	        verifyNoInteractions(auditService);
 249	    }
