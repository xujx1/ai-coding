 251	    private DeleteActivityRequest buildRequest(String requestId, String idempotencyKey, String activityId,
 252	                                               String regionCode, String operator) {
 253	        DeleteActivityRequest request = new DeleteActivityRequest();
 254	        request.setRequestId(requestId);
 255	        request.setIdempotencyKey(idempotencyKey);
 256	        request.setActivityId(activityId);
 257	        request.setRegionCode(regionCode);
 258	        request.setOperator(operator);
 259	        request.setCaller("caller");
 260	        request.setTimestampMs(1000L);
 261	        return request;
 262	    }
 263	
 264	    private Activity buildActivity(String activityId, String regionCode, String status, int version,
 265	                                   boolean isDeleted, String updatedBy) {
 266	        Activity activity = new Activity();
 267	        activity.setActivityId(activityId);
 268	        activity.setRegionCode(regionCode);
 269	        activity.setStatus(status);
 270	        activity.setVersion(version);
 271	        activity.setIsDeleted(isDeleted);
 272	        activity.setUpdatedBy(updatedBy);
 273	        activity.setUpdatedAt(123L);
 274	        activity.setCreatedBy("creator");
 275	        activity.setCreatedAt(100L);
 276	        activity.setActivityName("activity-" + activityId);
 277	        activity.setToolId("tool-1");
 278	        activity.setToolType("FULL_REDUCE");
 279	        activity.setTenantId("tenant-1");
 280	        return activity;
 281	    }
 282	
 283	    private String expectedRequestHash(DeleteActivityRequest request) {
 284	        return "{\"requestId\":\"" + request.getRequestId() + "\",\"caller\":\"caller\",\"operator\":\""
 285	                + request.getOperator() + "\",\"regionCode\":\"" + request.getRegionCode()
 286	                + "\",\"idempotencyKey\":\"" + request.getIdempotencyKey()
 287	                + "\",\"timestampMs\":1000,\"expectedVersion\":null,\"activityId\":\""
 288	                + request.getActivityId() + "\"}";
 289	    }
