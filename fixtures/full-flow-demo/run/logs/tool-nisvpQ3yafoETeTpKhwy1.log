 214	    @Test
 215	    @DisplayName("deleteActivity returns version conflict when concurrent delete leaves record still deletable")
 216	    void deleteActivityConcurrentDeleteVersionConflict() {
 217	        DeleteActivityRequest request = buildRequest("req-7", "idem-7", "act-7", "CN", "operator-7");
 218	        Activity activity = buildActivity("act-7", "CN", ActivityStatus.DRAFT.name(), 2, false, "old");
 219	        Activity current = buildActivity("act-7", "CN", ActivityStatus.DRAFT.name(), 2, false, "old");
 220	
 221	        when(idempotencyService.checkAndRecord(eq("idem-7"), eq("CN"), eq(expectedRequestHash(request)), eq(7), eq("req-7")))
 222	                .thenReturn(null);
 223	        when(activityMapper.selectByActivityId("act-7", "CN")).thenReturn(activity, current);
 224	        when(activityMapper.softDelete(eq("act-7"), eq("CN"), eq(ActivityStatus.DRAFT.name()), eq(2), anyLong(), eq("operator-7")))
 225	                .thenReturn(0);
 226	
 227	        RpcResult<Void> result = activityService.deleteActivity(request);
 228	
 229	        assertEquals(ErrorCode.VERSION_CONFLICT.getCode(), result.getCode());
 230	        assertEquals("Concurrent delete detected", result.getMessage());
 231	        verifyNoInteractions(auditService);
 232	        verify(idempotencyService, never()).markCompleted(eq("idem-7"), eq("CN"), eq(""));
 233	    }
