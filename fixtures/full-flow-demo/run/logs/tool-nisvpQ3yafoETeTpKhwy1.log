  77	    @Test
  78	    @DisplayName("deleteActivity deletes a draft activity and records audit plus idempotency result")
  79	    void deleteActivityDraftSuccess() {
  80	        DeleteActivityRequest request = buildRequest("req-1", "idem-1", "act-1", "CN", "operator-1");
  81	        Activity activity = buildActivity("act-1", "CN", ActivityStatus.DRAFT.name(), 3, false, "creator");
  82	
  83	        when(idempotencyService.checkAndRecord(eq("idem-1"), eq("CN"), eq(expectedRequestHash(request)), eq(7), eq("req-1")))
  84	                .thenReturn(null);
  85	        when(activityMapper.selectByActivityId("act-1", "CN")).thenReturn(activity);
  86	        when(activityMapper.softDelete(eq("act-1"), eq("CN"), eq(ActivityStatus.DRAFT.name()), eq(3), anyLong(), eq("operator-1")))
  87	                .thenReturn(1);
  88	
  89	        RpcResult<Void> result = activityService.deleteActivity(request);
  90	
  91	        assertTrue(result.isSuccess());
  92	        assertEquals(ErrorCode.SUCCESS.getCode(), result.getCode());
  93	        assertEquals("req-1", result.getRequestId());
  94	
  95	        ArgumentCaptor<String> beforeCaptor = ArgumentCaptor.forClass(String.class);
  96	        ArgumentCaptor<String> afterCaptor = ArgumentCaptor.forClass(String.class);
  97	        verify(auditService).logStateChange(eq("req-1"), eq("operator-1"), eq("DELETE_ACTIVITY"),
  98	                eq("Activity"), eq("act-1"), eq("CN"), beforeCaptor.capture(), afterCaptor.capture());
  99	        assertTrue(beforeCaptor.getValue().contains("\"status\":\"DRAFT\""));
 100	        assertTrue(beforeCaptor.getValue().contains("\"isDeleted\":false"));
 101	        assertTrue(beforeCaptor.getValue().contains("\"version\":3"));
 102	        assertTrue(afterCaptor.getValue().contains("\"isDeleted\":true"));
 103	        assertTrue(afterCaptor.getValue().contains("\"version\":4"));
 104	        assertTrue(afterCaptor.getValue().contains("\"updatedBy\":\"operator-1\""));
 105	        verify(idempotencyService).markCompleted(eq("idem-1"), eq("CN"), eq("{\"code\":0,\"message\":\"SUCCESS\",\"requestId\":\"req-1\",\"data\":null,\"success\":true}"));
 106	    }
